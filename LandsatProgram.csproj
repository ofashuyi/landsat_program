<Project Sdk="Microsoft.NET.Sdk.Web" InitialTargets="StopLockedDebugHostBeforeBuild">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LandsatProgram</RootNamespace>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>
  <Target Name="StopLockedDebugHostBeforeBuild"
          Condition="'$(Configuration)' == 'Debug' and '$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\Stop-LockedDebugHost.ps1&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -Configuration &quot;$(Configuration)&quot; -TargetFramework &quot;$(TargetFramework)&quot;"
          IgnoreExitCode="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low" />
  </Target>

  <Target Name="MinifyStaticAssets"
          BeforeTargets="Publish"
          Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\Minify-Assets.ps1&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot;"
          IgnoreExitCode="true" />
  </Target>
</Project>
