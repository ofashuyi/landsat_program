@{
    ViewData["Title"] = "Landsat Program Explorer | Briefing";
    ViewData["Description"] = "Choose a short Landsat briefing chapter: overview, foundations, missions, applications, product guidance, future direction, or resources.";
    ViewData["OgTitle"] = "Landsat Program Explorer | Briefing";
    ViewData["OgDescription"] = "A chapter-based Landsat briefing for mission history, applications, product guidance, and next steps.";
    ViewData["OgImage"] = "/img/landsat9.jpg";
    ViewData["OgUrl"] = "https://landsat.gsfc.nasa.gov/";
    ViewData["BodyClass"] = "page-briefing";
    ViewData["BrandHref"] = "/briefing";
    ViewData["BrandSubtitle"] = "Briefing chapters";
    ViewData["NavLinks"] = new[]
    {
        new NavigationLink("Overview", "/briefing/overview"),
        new NavigationLink("Foundations", "/briefing/foundations"),
        new NavigationLink("Fleet", "/briefing/missions"),
        new NavigationLink("Applications", "/briefing/applications"),
        new NavigationLink("Products", "/briefing/products"),
        new NavigationLink("Future", "/briefing/future"),
        new NavigationLink("Studio", "/studio")
    };

    var chapters = new[]
    {
        new { Number = "01", Title = "Program Overview", Text = "Start with the scale, continuity, and value of the Landsat record.", Href = "/briefing/overview" },
        new { Number = "02", Title = "Foundations", Text = "Learn cadence, scale, spectral range, and modern analysis-ready products.", Href = "/briefing/foundations" },
        new { Number = "03", Title = "Mission Fleet", Text = "Filter, inspect, and compare Landsat missions across the program timeline.", Href = "/briefing/missions" },
        new { Number = "04", Title = "Applications", Text = "See where Landsat supports water, agriculture, hazards, cities, and land change.", Href = "/briefing/applications" },
        new { Number = "05", Title = "Products", Text = "Choose between Level-1, Surface Reflectance, Surface Temperature, ARD, and HLS.", Href = "/briefing/products" },
        new { Number = "06", Title = "Future Direction", Text = "Understand what is stable and what is still evolving for Landsat continuity.", Href = "/briefing/future" },
        new { Number = "07", Title = "Resources", Text = "Jump to official portals, documentation, and the interactive studio.", Href = "/briefing/resources" }
    };
}

<section class="hero hero-compact" id="top">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/img/landsat9.jpg">
        <source data-src="/assets/landsat.mp4" type="video/mp4">
    </video>
    <button class="hero-video-toggle" type="button" data-video-toggle aria-pressed="false">Pause video</button>
    <div class="hero-overlay"></div>
    <div class="hero-grid container-xxl px-3 px-lg-4">
        <div class="hero-copy fade-up">
            <div class="eyebrow">Program Briefing | NASA + USGS</div>
            <h1>Explore Landsat one short chapter at a time.</h1>
            <p>
                Pick the chapter you need now, then move forward when the context is useful. The briefing no longer asks you
                to scroll through the whole program in one pass.
            </p>
            <div class="hero-actions">
                <a class="button button-primary" href="/briefing/overview">Start with overview</a>
                <a class="button" href="/studio">Open interactive studio</a>
            </div>
        </div>
        <aside class="hero-panel fade-up" aria-label="Briefing structure">
            <h2>Short-page structure</h2>
            <ul class="hero-panel-list">
                <li>
                    <strong>One topic per page</strong>
                    <span class="body-copy">Overview, foundations, fleet, applications, data, future, and resources each get their own route.</span>
                </li>
                <li>
                    <strong>Interactive tools stay focused</strong>
                    <span class="body-copy">Mission comparison, workflow guidance, and the studio tools now live where users expect them.</span>
                </li>
                <li>
                    <strong>Old entry points still work</strong>
                    <span class="body-copy">Legacy anchors redirect to the closest new chapter, so bookmarked sections remain useful.</span>
                </li>
            </ul>
        </aside>
    </div>
</section>

<main class="shell container-xxl px-3 px-lg-4">
    <section id="briefing-chapters">
        <div class="section-heading row g-3 align-items-end">
            <div class="col-lg-7">
                <div class="eyebrow">Briefing Chapters</div>
                <h2>Choose the next short page</h2>
            </div>
            <div class="col-lg-5">
                <p class="body-copy">
                    Each chapter is intentionally smaller than the old long page, with previous and next links to preserve
                    the story when you want to move in sequence.
                </p>
            </div>
        </div>
        <div class="chapter-grid">
            @foreach (var chapter in chapters)
            {
                <a class="chapter-card" href="@chapter.Href">
                    <span>@chapter.Number</span>
                    <strong>@chapter.Title</strong>
                    <p>@chapter.Text</p>
                </a>
            }
        </div>
    </section>

    <footer class="site-footer">
        <h3>About the split</h3>
        <p>
            The app now uses MVC routes for short chapters and dedicated tools. This keeps the learning path intact while
            reducing the scroll depth on any single page.
        </p>
    </footer>
</main>
