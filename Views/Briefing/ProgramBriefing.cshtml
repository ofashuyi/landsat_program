@{
    ViewData["Title"] = "Landsat Program Explorer | Briefing";
    ViewData["Description"] = "Choose a Landsat tutoring chapter with source-backed remote sensing concepts, practical workflows, case studies, media, and studio exercises.";
    ViewData["OgTitle"] = "Landsat Program Explorer | Briefing";
    ViewData["OgDescription"] = "A chapter-based Landsat briefing for mission history, applications, product guidance, and next steps.";
    ViewData["OgImage"] = "/img/landsat9.jpg";
    ViewData["OgUrl"] = "https://landsat.gsfc.nasa.gov/";
    ViewData["BodyClass"] = "page-briefing";
    ViewData["BrandHref"] = "/briefing";
    ViewData["BrandSubtitle"] = "Briefing chapters";
    ViewData["NavLinks"] = new[]
    {
        new NavigationLink("Overview", "/briefing/overview"),
        new NavigationLink("Foundations", "/briefing/foundations"),
        new NavigationLink("Fleet", "/briefing/missions"),
        new NavigationLink("Applications", "/briefing/applications"),
        new NavigationLink("Products", "/briefing/products"),
        new NavigationLink("Future", "/briefing/future"),
        new NavigationLink("Studio", "/studio")
    };

    var chapters = new[]
    {
        new { Number = "01", Title = "Program Overview", Text = "Start with the continuity, public value, and why moderate-resolution land imaging matters.", Href = "/briefing/overview" },
        new { Number = "02", Title = "Foundations", Text = "Learn pixel size, spectral response, revisit cadence, radiometry, and common beginner misconceptions.", Href = "/briefing/foundations" },
        new { Number = "03", Title = "Mission Fleet", Text = "Compare sensors, mission eras, Landsat 7's end, and the reason archive continuity is powerful.", Href = "/briefing/missions" },
        new { Number = "04", Title = "Applications", Text = "Work through water, agriculture, fire, urban heat, forest, and land-change case studies.", Href = "/briefing/applications" },
        new { Number = "05", Title = "Products", Text = "Choose Level-1, Surface Reflectance, Surface Temperature, ARD, or HLS for a practical task.", Href = "/briefing/products" },
        new { Number = "06", Title = "Future Direction", Text = "Separate stable Landsat continuity needs from evolving Landsat Next architecture decisions.", Href = "/briefing/future" },
        new { Number = "07", Title = "Resources", Text = "Use official portals, high-resolution imagery, videos, documentation, and classroom resources.", Href = "/briefing/resources" }
    };
}

<section class="hero hero-compact" id="top">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/img/landsat-hero-poster.jpg">
        <source data-src="/assets/landsat.mp4" type="video/mp4">
    </video>
    <button class="hero-video-toggle" type="button" data-video-toggle aria-pressed="false">Pause video</button>
    <div class="hero-overlay"></div>
    <div class="hero-grid container-xxl px-3 px-lg-4">
        <div class="hero-copy fade-up">
            <div class="eyebrow">Program Briefing | NASA + USGS</div>
            <h1>Explore Landsat one short chapter at a time.</h1>
            <p>
                Pick the chapter you need now, then move from concept to interpretation. Each page is shaped like a short
                tutoring session: learn the idea, inspect a real use case, then practice in the studio.
            </p>
            <div class="hero-actions">
                <a class="button button-primary" href="/briefing/overview">Start with overview</a>
                <a class="button" href="/studio">Open interactive studio</a>
            </div>
        </div>
        <aside class="hero-panel fade-up" aria-label="Briefing structure">
            <h2>Short-page structure</h2>
            <ul class="hero-panel-list">
                <li>
                    <strong>Learn, then apply</strong>
                    <span class="body-copy">Every chapter now points toward practical remote-sensing choices, not just facts to memorize.</span>
                </li>
                <li>
                    <strong>Real source trail</strong>
                    <span class="body-copy">NASA and USGS pages, product guides, media galleries, and education resources are linked where they help.</span>
                </li>
                <li>
                    <strong>Studio practice</strong>
                    <span class="body-copy">Exercises connect bands, indices, thermal products, QA masks, scenes, and interpretation habits.</span>
                </li>
            </ul>
        </aside>
    </div>
</section>

<main class="shell container-xxl px-3 px-lg-4">
    <section id="briefing-chapters">
        <div class="section-heading row g-3 align-items-end">
            <div class="col-lg-7">
                <div class="eyebrow">Briefing Chapters</div>
                <h2>Choose the next short page</h2>
            </div>
            <div class="col-lg-5">
                <p class="body-copy">
                    Chapters are short enough for tutoring, but each one now carries richer scholastic content: objectives,
                    vocabulary, examples, practice prompts, and official media sources.
                </p>
            </div>
        </div>
        <div class="chapter-grid">
            @foreach (var chapter in chapters)
            {
                <a class="chapter-card" href="@chapter.Href">
                    <span>@chapter.Number</span>
                    <strong>@chapter.Title</strong>
                    <p>@chapter.Text</p>
                </a>
            }
        </div>
    </section>

    <footer class="site-footer">
        <h3>About the split</h3>
        <p>
            Use this as a guided remote-sensing notebook: start with the briefing, jump to official NASA/USGS references
            when needed, and return to the studio when an idea needs to become visual.
        </p>
    </footer>
</main>
