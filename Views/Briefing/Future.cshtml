@{
    ViewData["Title"] = "Landsat Future Direction | Briefing";
    ViewData["Description"] = "What is stable and what is still evolving for Landsat continuity.";
    ViewData["OgTitle"] = "Landsat Future Direction";
    ViewData["OgDescription"] = "A short page on Landsat continuity and the evolving next-generation architecture.";
    ViewData["OgImage"] = "/img/landsat9.jpg";
    ViewData["BodyClass"] = "page-briefing";
    ViewData["BrandHref"] = "/briefing";
    ViewData["BrandSubtitle"] = "Briefing chapters";
    ViewData["NavLinks"] = new[]
    {
        new NavigationLink("Chapters", "/briefing"),
